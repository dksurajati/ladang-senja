---
import Scene from "./Scene.astro";
import { formatIDR } from "../data/site.js";

const { villa } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="villa-card" href={`${base}villas/${villa.slug}/`}>
  <div class="art"><Scene variant={villa.scene} label={`Illustration for ${villa.name}`} /></div>
  <h3>{villa.name}</h3>
  <div class="villa-meta">
    <span>{villa.bedrooms} bedroom{villa.bedrooms > 1 ? "s" : ""}</span>
    <span>Up to {villa.guests} guests</span>
    <span>{villa.size} m²</span>
  </div>
  <p class="muted" style="margin: 8px 0 0">{villa.summary}</p>
  <p class="price">{formatIDR(villa.price)} <span>/ night</span></p>
</a>
