---
import Scene from "./Scene.astro";
import { formatIDR } from "../data/site.js";
import { useTranslations, localePath } from "../i18n/ui.js";

const { villa, lang } = Astro.props;
const t = useTranslations(lang);
---
<a class="villa-card" href={localePath(lang, `villas/${villa.slug}/`)}>
  <div class="art"><Scene variant={villa.scene} label={t("villa.art")(villa.name)} /></div>
  <h3>{villa.name}</h3>
  <div class="villa-meta">
    <span>{t("villa.bedrooms")(villa.bedrooms)}</span>
    <span>{t("villa.upToGuests")(villa.guests)}</span>
    <span>{villa.size} m²</span>
  </div>
  <p class="muted" style="margin: 8px 0 0">{villa.summary}</p>
  <p class="price">{formatIDR(villa.price)} <span>{t("villa.perNightShort")}</span></p>
</a>
