---
import Base from "../../layouts/Base.astro";
import Scene from "../../components/Scene.astro";
import { villas, formatIDR } from "../../data/site.js";

// Static site generation: one page per villa, built at build time.
export function getStaticPaths() {
  return villas.map((villa) => ({ params: { slug: villa.slug }, props: { villa } }));
}

const { villa } = Astro.props;
const others = villas.filter((v) => v.slug !== villa.slug);
const base = import.meta.env.BASE_URL;
---
<Base title={villa.name} description={villa.summary}>
  <div class="detail-hero"><Scene variant={villa.scene} label={`Illustration for ${villa.name}`} /></div>

  <section class="section">
    <div class="wrap">
      <a class="back" href={`${base}#villas`}>← All villas</a>
      <div class="detail">
        <div>
          <p class="eyebrow">{villa.bedrooms} bedroom{villa.bedrooms > 1 ? "s" : ""} · {villa.size} m²</p>
          <h1>{villa.name}</h1>
          <p style="font-size: 1.15rem">{villa.summary}</p>
          <p class="muted">{villa.description}</p>
          <h3 style="margin-top: 2rem">In the villa</h3>
          <ul class="feature-list">
            {villa.features.map((f) => <li>{f}</li>)}
          </ul>
        </div>

        <aside class="booking-card">
          <p class="eyebrow" style="margin: 0">From</p>
          <p style="font-family: var(--serif); font-size: 2.2rem; margin: 0">{formatIDR(villa.price)}</p>
          <p class="small muted">per night, breakfast included</p>
          <dl>
            <dt>Guests</dt><dd>Up to {villa.guests}</dd>
            <dt>Bedrooms</dt><dd>{villa.bedrooms}</dd>
            <dt>Size</dt><dd>{villa.size} m²</dd>
          </dl>
          <a class="btn" style="width: 100%; text-align: center" href={`${base}?villa=${villa.slug}#enquire`}>Check dates</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Other villas</h2>
      <div class="others">
        {others.map((o) => <a class="btn btn-ghost" href={`${base}villas/${o.slug}/`}>{o.name}</a>)}
      </div>
    </div>
  </section>
</Base>
