---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getSite, languages, defaultLang } from "../data/site.js";
import { useTranslations, localePath, switchLangPath } from "../i18n/ui.js";

interface Props {
  lang?: "en" | "id";
  title?: string;
  description?: string;
}
const { lang = defaultLang, title } = Astro.props;
const site = getSite(lang);
const t = useTranslations(lang);
const description = Astro.props.description ?? site.tagline;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${t("meta.defaultTitle")}`;
const base = import.meta.env.BASE_URL;
const home = localePath(lang);
const alternates = languages.map((l) => ({ lang: l, href: switchLangPath(Astro.url.pathname, l) }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5EEE3" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t("skip")}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={home}>{site.name}</a>
        <nav aria-label={t("nav.label")}>
          <a href={`${home}#villas`}>{t("nav.villas")}</a>
          <a href={`${home}#experiences`}>{t("nav.experiences")}</a>
          <a class="nav-cta" href={`${home}#enquire`}>{t("nav.enquire")}</a>
          <span class="lang-switch" role="group" aria-label={t("lang.label")}>
            {alternates.map((a) => (
              <a href={a.href} hreflang={a.lang} lang={a.lang} aria-current={a.lang === lang ? "true" : undefined}>
                {a.lang.toUpperCase()}
              </a>
            ))}
          </span>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p class="brand">{site.name}</p>
          <p class="muted">{site.location}</p>
        </div>
        <p class="muted small concept-note">
          {t("footer.concept")(site.name)}
          <a href={site.authorUrl}>{site.author}</a> {t("footer.conceptEnd")}
        </p>
      </div>
    </footer>

    <script>
      // Switch language without a full page reload: the client router swaps the page in place,
      // and we carry over the reading position and anything typed into the enquiry form.
      import { navigate } from "astro:transitions/client";

      type Carry = { section: number; offset: number; fields: Record<string, string> };
      let carry: Carry | null = null;

      const sections = () => Array.from(document.querySelectorAll<HTMLElement>("main > *"));

      function capture(): Carry {
        const list = sections();
        let section = 0;
        list.forEach((el, i) => {
          if (el.getBoundingClientRect().top <= 1) section = i;
        });
        const offset = list[section] ? -list[section].getBoundingClientRect().top : window.scrollY;
        const fields: Record<string, string> = {};
        const form = document.getElementById("enquiry-form") as HTMLFormElement | null;
        if (form) new FormData(form).forEach((v, k) => (fields[k] = String(v)));
        return { section, offset, fields };
      }

      document.addEventListener("click", (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>(".lang-switch a");
        if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        if (link.hasAttribute("aria-current")) return;
        carry = capture();
        navigate(link.pathname + location.search + location.hash);
      }, true); // capture phase, so this runs before the router's own link handler

      // Runs after the router has swapped the page and scrolled, so our position wins.
      document.addEventListener("astro:after-swap", () => {
        if (!carry) return;
        const { section, offset, fields } = carry;
        carry = null;
        const form = document.getElementById("enquiry-form") as HTMLFormElement | null;
        if (form) {
          for (const [name, value] of Object.entries(fields)) {
            const el = form.elements.namedItem(name) as HTMLInputElement | null;
            if (el) el.value = value;
          }
          // The form pre-selects ?villa= on load; keep it in step with the villa carried over.
          const url = new URL(location.href);
          if (fields.villa && url.searchParams.has("villa")) {
            url.searchParams.set("villa", fields.villa);
            history.replaceState(history.state, "", url);
          }
        }
        const target = sections()[section];
        if (target) window.scrollTo({ top: target.offsetTop + offset, behavior: "instant" });
      });

      // Keep ?villa=… and #section on the plain links too (used when opened in a new tab).
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLAnchorElement>(".lang-switch a").forEach((a) => {
          a.href = a.pathname + location.search + location.hash;
        });
      });
    </script>
  </body>
</html>
